{
  "title": "Are Frontier VLM Agents Ready to Be Robot Generalists? An Empirical Study with the Embodied Agent Arena",
  "description": "Ten frontier VLM agents evaluated across five robotic capabilities on 1,000 cases, connecting local precision to complete task execution.",
  "url": "https://embodied-agent-arena.github.io/embodied-agent-arena/",
  "arxiv": "2610.00854",
