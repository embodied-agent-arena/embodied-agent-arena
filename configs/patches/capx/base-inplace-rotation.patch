+    def rotate_base_in_place(self, delta_yaw, *, settle_steps=2):
+        """
+        Rotate the holonomic base about the world z axis in place.
+
+        The base is a six-DoF holonomic joint (x, y, z, rx, ry, rz) whose joint
+        values are intrinsic Euler angles, so adding to one joint index is not a
+        yaw delta. set_position_orientation is the class's own supported way of
+        moving the base while the simulator is playing: it converts the requested
+        world pose into the six base joints for us, so the requested rotation is
+        applied exactly.
+
+        Routing the sweep through the base motion planner is what originally
+        failed: planning a path to a pose at the robot's own footprint has no
+        solution and raised ActionPrimitiveError(PLANNING_ERROR), which left the
+        base stationary for the whole scan.
+
+        Args:
+            delta_yaw: Relative yaw in radians applied about the world z axis.
+            settle_steps: Settle iterations that let physics follow the new pose.
+        Returns:
+            success: Whether the base yaw actually changed.
+        """
+        robot = self.robot
+        before = quat2yaw(robot.get_position_orientation()[1])
+        position, orientation = robot.get_position_orientation()
+        delta = euler2quat(torch.tensor([0.0, 0.0, float(delta_yaw)]))
+        robot.set_position_orientation(position, quat_multiply(delta, orientation))
+        for _ in range(max(1, int(settle_steps))):
+            self._settle_robot()
+        after = quat2yaw(robot.get_position_orientation()[1])
+        return abs(after - before) > 0.1
+
